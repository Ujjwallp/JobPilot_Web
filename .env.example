# ─────────────────────────────────────────────────────────────
#  JobPilot — Firebase configuration
# ─────────────────────────────────────────────────────────────
#  1. Create a project at https://console.firebase.google.com
#  2. Project settings → "Your apps" → Web app → copy the config
#  3. Copy this file to ".env" and paste the values below.
#
#  Fill these values with your Firebase project configuration.
#  Firebase Authentication and Firestore are required for the app to run.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
